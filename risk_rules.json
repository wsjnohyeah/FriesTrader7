{
  "_comment": "Hard limits for the Claude Code + Alpaca-data + Robinhood-execution workflow. The agent may read but must never modify this file during a scheduled run.",
  "analysis_model": {
    "provider": "anthropic",
    "runtime": "claude_code",
    "model_family": "claude",
    "model_id": null,
    "model_selected_by_human": true,
    "selection_location": "Claude Code scheduled-task configuration",
    "fallback_allowed": false
  },
  "market_data": {
    "provider": "alpaca",
    "market_data_api_base_url": "https://data.alpaca.markets",
    "market_data_feed": "sip",
    "api_key_env": "ALPACA_API_KEY_ID",
    "api_secret_env": "ALPACA_API_SECRET_KEY",
    "read_only": true,
    "note": "Alpaca is used only for SIP quotes, bars, screeners, and news. No Alpaca account, position, or order endpoint may be called. Credentials are environment variables only."
  },
  "execution_broker": {
    "provider": "robinhood_mcp",
    "account_number": "YOUR_ROBINHOOD_AGENTIC_ACCOUNT_NUMBER",
    "order_preview_required": true,
    "note": "Robinhood MCP is the sole source for cash, portfolio, positions, executable quotes, order review, placement, and fill state."
  },
  "starting_capital_usd": 500.0,
  "starting_capital_usd_note": "Set this to net deposits minus withdrawals. Update it manually after funding changes.",
  "execution": {
    "mode": "dry_run",
    "allowed_modes": ["dry_run", "live"],
    "dry_run_min_cycles_before_live": 10,
    "live_prerequisites": {
      "durable_order_intent_journal": false,
      "single_run_lock": false,
      "startup_order_reconciliation": false,
      "ambiguous_submission_recovery_tested": false
    },
    "note": "Only the human may change dry_run to live. The agent must never change this value. Live orders are placed only through the configured Robinhood MCP account."
  },
  "universe": {
    "robinhood_watchlist_name": "YOUR_WATCHLIST_NAME_HERE",
    "seed_symbols": [],
    "include_open_positions": true,
    "dynamic_discovery": {
      "enabled": true,
      "movers_top": 50,
      "most_actives_top": 50,
      "most_actives_by": "volume",
      "recent_news_limit": 50,
      "max_dynamic_candidates_after_ranking": 40
    },
    "min_price_usd": 5.0,
    "min_avg_daily_dollar_volume_usd": 20000000,
    "min_market_cap_usd": 300000000,
    "max_market_cap_usd": null,
    "leveraged_etf_filter_enabled": true,
    "inverse_etf_filter_enabled": true,
    "note": "Alpaca supplies market data and news, not a complete fundamentals database. Use Robinhood fundamentals or cited primary filings; never invent market cap, valuation, earnings estimates, or financial ratios."
  },
  "persistent_candidate_pool": {
    "enabled": true,
    "path": "candidate_universe.json",
    "max_candidates": 100,
    "default_ttl_calendar_days": 14,
    "max_upcoming_catalyst_days": 90,
    "allowed_statuses": ["active_opportunity", "upcoming_catalyst", "monitor", "held"],
    "note": "This repository-owned pool is independent of the Robinhood watchlist. Each entry needs sourced reasons, a next-review date, and an expiry date."
  },
  "technical_scan": {
    "daily_history_calendar_days": 420,
    "daily_move_abs_pct": 0.03,
    "opening_gap_abs_pct": 0.02,
    "intraday_range_pct": 0.035,
    "relative_volume_multiple": 1.5,
    "price_move_20d_abs_pct": 0.08,
    "breakout_20d_buffer_pct": 0.005,
    "minimum_signals_required": 1,
    "rank_weights": {
      "daily_move": 1.0,
      "opening_gap": 0.8,
      "intraday_range": 1.0,
      "relative_volume": 1.2,
      "price_move_20d": 0.8,
      "breakout_20d": 1.0
    }
  },
  "research": {
    "max_dynamic_names_per_cycle": 20,
    "always_research_open_positions": true,
    "news_lookback_days": 7,
    "minimum_independent_sources": 2,
    "require_primary_or_wire_for_high_conviction": true,
    "analysis_depth": "detailed",
    "required_sections": [
      "executive_summary",
      "catalyst_and_timeline",
      "news_evidence",
      "technical_setup",
      "bull_case",
      "bear_case",
      "invalidation",
      "risk_flags",
      "data_gaps"
    ]
  },
  "data_crosscheck": {
    "enabled": true,
    "max_quote_divergence_pct": 0.01,
    "max_alpaca_quote_age_seconds": 120,
    "on_failure": "block_new_entries",
    "note": "Robinhood ask/bid controls executable sizing; Alpaca SIP is an independent sanity check. A stale or materially divergent Alpaca quote blocks buys but never blocks risk-reducing sells."
  },
  "position_sizing": {
    "conviction_pct": {"high": 0.20, "medium": 0.12, "low": 0.06},
    "max_position_pct_of_account": 0.20,
    "max_concurrent_positions": 4,
    "min_cash_buffer_pct": 0.10,
    "min_top_up_usd": 5.0,
    "min_top_up_pct_of_target": 0.10
  },
  "stop_loss": {
    "mode": "volatility_scaled",
    "hard_stop_pct": 0.07,
    "volatility_lookback_trading_days": 20,
    "volatility_stdev_multiplier": 2.5,
    "min_stop_pct": 0.05,
    "max_stop_pct": 0.15,
    "fallback_stop_pct": 0.07
  },
  "take_profit": {
    "tiers": [
      {"gain_pct": 0.15, "sell_fraction_of_position": 0.25},
      {"gain_pct": 0.30, "sell_fraction_of_position": 0.25},
      {"gain_pct": 0.50, "sell_fraction_of_position": 0.25}
    ]
  },
  "conviction_trim": {
    "enabled": true,
    "overweight_trigger_pct": 0.25,
    "min_low_conviction_cycles": 3
  },
  "sell_reentry_lock": {"gain_close_max_trading_days": 10},
  "loss_limits": {
    "daily_loss_limit_pct_of_account": 0.05,
    "weekly_loss_limit_pct_of_account": 0.10,
    "pnl_basis": "robinhood_realized_pnl",
    "note": "Entry halts use Robinhood realized P&L. Open-position downside is handled separately by mandatory stop checks."
  },
  "wash_sale_avoidance": {
    "enabled": true,
    "lookback_window_days": 30,
    "linked_accounts": ["YOUR_ROBINHOOD_AGENTIC_ACCOUNT_NUMBER"],
    "note": "List every Robinhood account the MCP can inspect. The human remains responsible for accounts at other brokers."
  },
  "entry_price_gap": {"max_pct": 0.03},
  "entry_extension": {
    "enabled": true,
    "lookback_trading_days": 20,
    "max_extension_pct": 0.10
  }
}
