{
  "_comment": "Hard limits for the Codex + Alpaca paper-trading workflow. The agent may read but must never modify this file during a scheduled run.",
  "analysis_model": {
    "provider": "openai",
    "model_id": "gpt-6-astra",
    "selection_location": "Codex automation configuration",
    "fallback_allowed": false
  },
  "broker": {
    "provider": "alpaca",
    "account_mode": "paper",
    "trading_api_base_url": "https://paper-api.alpaca.markets/v2",
    "market_data_api_base_url": "https://data.alpaca.markets",
    "market_data_feed": "sip",
    "api_key_env": "ALPACA_API_KEY_ID",
    "api_secret_env": "ALPACA_API_SECRET_KEY",
    "live_trading_endpoint_prohibited": true,
    "note": "Credentials are environment variables only. Never place them in this file, a prompt, a log, or a commit. This repository intentionally permits paper trading only."
  },
  "starting_capital_usd": 500.0,
  "starting_capital_usd_note": "Set this to net deposits minus withdrawals. Update it manually after funding changes.",
  "execution": {
    "mode": "dry_run",
    "allowed_modes": ["dry_run", "paper"],
    "dry_run_min_cycles_before_paper": 10,
    "note": "Only the human may change dry_run to paper. The agent must never change this value. Real-money/live endpoints are prohibited."
  },
  "universe": {
    "alpaca_watchlist_name": "",
    "seed_symbols": [],
    "include_open_positions": true,
    "dynamic_discovery": {
      "enabled": true,
      "movers_top": 50,
      "most_actives_top": 50,
      "most_actives_by": "volume",
      "recent_news_limit": 100,
      "max_dynamic_candidates_after_ranking": 40
    },
    "eligible_exchanges": ["NASDAQ", "NYSE", "AMEX", "ARCA", "BATS"],
    "min_price_usd": 5.0,
    "min_avg_daily_dollar_volume_usd": 20000000,
    "exclude_otc": true,
    "require_tradable": true,
    "note": "Alpaca supplies market data and asset metadata, not a complete fundamentals database. Do not invent market cap, valuation, earnings estimates, or financial ratios."
  },
  "technical_scan": {
    "daily_history_calendar_days": 420,
    "daily_move_abs_pct": 0.03,
    "opening_gap_abs_pct": 0.02,
    "intraday_range_pct": 0.035,
    "relative_volume_multiple": 1.5,
    "price_move_20d_abs_pct": 0.08,
    "breakout_20d_buffer_pct": 0.005,
    "minimum_signals_required": 1,
    "rank_weights": {
      "daily_move": 1.0,
      "opening_gap": 0.8,
      "intraday_range": 1.0,
      "relative_volume": 1.2,
      "price_move_20d": 0.8,
      "breakout_20d": 1.0
    }
  },
  "research": {
    "max_dynamic_names_per_cycle": 20,
    "always_research_open_positions": true,
    "news_lookback_days": 7,
    "minimum_independent_sources": 2,
    "require_primary_or_wire_for_high_conviction": true,
    "analysis_depth": "detailed",
    "required_sections": [
      "executive_summary",
      "catalyst_and_timeline",
      "news_evidence",
      "technical_setup",
      "bull_case",
      "bear_case",
      "invalidation",
      "risk_flags",
      "data_gaps"
    ]
  },
  "position_sizing": {
    "conviction_pct": {"high": 0.20, "medium": 0.12, "low": 0.06},
    "max_position_pct_of_account": 0.20,
    "max_concurrent_positions": 4,
    "min_cash_buffer_pct": 0.10,
    "min_top_up_usd": 5.0,
    "min_top_up_pct_of_target": 0.10
  },
  "stop_loss": {
    "mode": "volatility_scaled",
    "hard_stop_pct": 0.07,
    "volatility_lookback_trading_days": 20,
    "volatility_stdev_multiplier": 2.5,
    "min_stop_pct": 0.05,
    "max_stop_pct": 0.15,
    "fallback_stop_pct": 0.07
  },
  "take_profit": {
    "tiers": [
      {"gain_pct": 0.15, "sell_fraction_of_position": 0.25},
      {"gain_pct": 0.30, "sell_fraction_of_position": 0.25},
      {"gain_pct": 0.50, "sell_fraction_of_position": 0.25}
    ]
  },
  "conviction_trim": {
    "enabled": true,
    "overweight_trigger_pct": 0.25,
    "min_low_conviction_cycles": 3
  },
  "sell_reentry_lock": {"gain_close_max_trading_days": 10},
  "loss_limits": {
    "daily_loss_limit_pct_of_account": 0.05,
    "weekly_loss_limit_pct_of_account": 0.10,
    "include_unrealized_pnl": true,
    "note": "Use Alpaca portfolio-history account P&L so open-position drawdown is not ignored."
  },
  "wash_sale_avoidance": {
    "enabled": true,
    "lookback_window_days": 30,
    "scope": "configured_alpaca_account_only",
    "note": "One Alpaca credential cannot inspect unrelated brokerage accounts. The human remains responsible for cross-account wash-sale tracking."
  },
  "entry_price_gap": {"max_pct": 0.03},
  "entry_extension": {
    "enabled": true,
    "lookback_trading_days": 20,
    "max_extension_pct": 0.10
  }
}
